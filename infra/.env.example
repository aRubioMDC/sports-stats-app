# Copy to infra/.env and fill in real values. Loaded two ways:
#  - docker compose auto-substitutes ${VARS} in docker-compose.yml from this file
#    (only works when you run `docker compose` from inside infra/).
#  - the `backend` service also loads it directly as container environment via `env_file:`.
# chmod 600 infra/.env once created — it holds the Supabase connection string.

# --- compose variable substitution (image selection) ---
GHCR_OWNER=your-github-username-lowercase
IMAGE_TAG=latest

# --- backend runtime config (backend/app/config.py Settings) ---
DATABASE_URL=postgresql+psycopg2://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres
ODDS_API_KEY=
SMALL_SAMPLE_WEEK_THRESHOLD=3
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
CORS_ORIGINS=http://localhost:5174,http://localhost:4174,http://127.0.0.1:5174,http://127.0.0.1:4174
